# Optional when running from source: the app can also ask for the key on first launch.
OPENAI_API_KEY=sk-...

# Optional tuning
FOCUS_MINUTES=25
BREAK_MINUTES=5
CHECK_INTERVAL_SECONDS=3
DRIFT_GRACE_SECONDS=5
# Alert only when the AI is at least this sure you are distracted (0-1)…
DISTRACTED_THRESHOLD=0.8
# …for this many checks in a row
CONFIRM_CHECKS=2
# Set to 1 to keep the last 20 checks (screenshots + verdict) in ./debug
DEBUG_SAVE_SHOTS=0
# How long the alert takes to grow to almost full screen if you ignore it
GROW_SECONDS=120

# Model used to write the one-liner (Responses API, sees the screenshot)
QUIP_MODEL=gpt-6-luna
